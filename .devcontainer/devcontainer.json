{
  "name": "⚡ ⚡ devcontainerb ⚡ ⚡",
  "privileged": true,
  "overrideCommand": false,
  "build": {
    "dockerfile": "./Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "daemonArgs": "--iptables=false --ip6tables=false" // ✅ fixes iptables on Apple
    }
  },
  // Load environment variables from the generated env-file (local/.env — built by
  // scripts/build-env.sh by merging local/env.defaults + local/env.local)
  "runArgs": [
    "--name",
    "devcontainer-workspace",
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/local/.env",
    // "--gpus",
    // "all",
    "--cgroupns=host",
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/local/.env"
  ],
  // Ensure the env-file exists on the host before `docker run --env-file` (runArgs above)
  // reads it. It starts empty on first creation; post-create.sh then populates it by
  // merging env.defaults + env.local inside the container. init-host.sh is resilient
  // and, on WSL, prints the exact chown fix if a prior root-owned run blocks creation.
  "initializeCommand": "bash '${localWorkspaceFolder}/.devcontainer/scripts/init-host.sh'",
  // ghcr.io login runs inside the container (docker-in-docker) via scripts/post-start.sh,
  // not here as an initializeCommand — the latter runs on the host and would not
  // authenticate the in-container docker daemon that `docker compose --build` uses.
  "mounts": [
    "source=shell-history-devcontainerb,target=/root/.shell_history_dir,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer/CLAUDE.md,target=${containerWorkspaceFolder}/.github/CLAUDE.md,type=bind",
    "source=${localWorkspaceFolder}/dotfiles,target=/root/dotfiles,type=bind",
    "source=zsh-history,target=/root/.zsh_history_container,type=volume",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind",
    "source=${localEnv:HOME}/.config/gcloud,target=/root/.config/gcloud,type=bind",
    "source=gh-config,target=/root/.config/gh,type=volume",
    "source=aws-sso-cache,target=/root/.aws/sso,type=volume",
    "source=twilio-config,target=/root/.twilio-cli,type=volume"
  ],
  "containerEnv": {
    "AWS_PROFILE": "dev",
    // The GODEBUG=netdns=cgo forces Go to use the same C DNS resolver that curl/nslookup use, avoiding the UDP timeout issue.
    // For Terraform
    "GODEBUG": "netdns=cgo"
  },
  "postCreateCommand": "bash -lc '${containerWorkspaceFolder}/.devcontainer/scripts/post-create.sh'",
  "postStartCommand": "bash -lc '${containerWorkspaceFolder}/.devcontainer/scripts/post-start.sh'",
  "forwardPorts": [
    80,
    2019,
    3000,
    3001,
    3400,
    3401,
    5173,
    6379,
    4040,
    4566,
    8000,
    8001,
    8080,
    8888,
    9000,
    9090,
    16686
  ],
  "portsAttributes": {
    "80": {
      "label": "Caddy (Local Reverse Proxy)",
      "onAutoForward": "notify"
    },
    "2019": {
      "label": "Caddy Admin API",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Pulse",
      "onAutoForward": "notify"
    },
    "3001": {
      "label": "Twilio Dev Phone",
      "onAutoForward": "notify"
    },
    "3400": {
      "label": "Librarian Scanner",
      "onAutoForward": "notify"
    },
    "3401": {
      "label": "Librarian API",
      "onAutoForward": "notify"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "notify"
    },
    "4040": {
      "label": "Ngrok",
      "onAutoForward": "notify"
    },
    "4566": {
      "label": "LocalStack",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Dev Server (Vite/etc)",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Voice Core",
      "onAutoForward": "notify"
    },
    "8001": {
      "label": "DynamoDB Admin UI",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "cohorts-api",
      "onAutoForward": "notify"
    },
    "8888": {
      "label": "Jupyter Notebook",
      "onAutoForward": "notify"
    },
    "9090": {
      "label": "Prometheus",
      "onAutoForward": "notify"
    },
    "9000": {
      "label": "Workflows Webhooks",
      "onAutoForward": "notify"
    },
    "16686": {
      "label": "Jaeger",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "github.copilot-chat",
        "streetsidesoftware.code-spell-checker",
        "postman.postman-for-vscode",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "chat.mcp.enabled": true,
        "editor.tabSize": 4,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        },
        "extensions.ignoreRecommendations": true,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        },
        "[hcl]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        }
      },
      "mcp": {
        "servers": {
          "terraform": {
            "command": "docker",
            "args": [
              "run",
              "-i",
              "--rm",
              "hashicorp/terraform-mcp-server"
            ]
          },
          "posthog": {
            "type": "stdio",
            // POSTHOG_PERSONAL_API_KEY is a secret — it is NOT hardcoded here. The wrapper
            // sources the generated .env at launch so the key never lives in this file.
            // ${containerWorkspaceFolder} is substituted by the devcontainer tooling (same as
            // runArgs --env-file uses ${localWorkspaceFolder}), so no path is hardcoded.
            "command": "bash",
            "args": [
              "-lc",
              "set -a; [ -f ${containerWorkspaceFolder}/.devcontainer/local/.env ] && . ${containerWorkspaceFolder}/.devcontainer/local/.env; set +a; exec npx -y @posthog/mcp-server"
            ],
            "env": {
              "POSTHOG_PROJECT_ID": "12345",
              "POSTHOG_HOST": "https://us.i.posthog.com"
            }
          },
          // "roark": {
          //   "command": "npx",
          //   "args": [
          //     "-y",
          //     "@roarkanalytics/sdk-mcp"
          //   ],
          //   "env": {
          //     "ROARK_API_BEARER_TOKEN": "$ROARK_API_KEY"
          //   }
          // },
          // "postman": {
          //   "type": "http",
          //   "url": "https://mcp.postman.com/mcp",
          //   "headers": {
          //     "Authorization": "${input:Authorization}"
          //   },
          //   "gallery": "https://api.mcp.github.com",
          //   "version": "2.8.7"
          // },
          "figma": {
            "type": "http",
            "url": "https://mcp.figma.com/mcp",
            "gallery": "https://api.mcp.github.com",
            "version": "1.0.3"
          }
        }
      }
    }
  }
}
