{
  "name": "⚡ ⚡ devcontainerb ⚡ ⚡",
  "build": {
    "dockerfile": "./Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // Load environment variables from .env file (create from .env.example)
  "runArgs": [
    "--name",
    "devcontainer-workspace",
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/.env"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.zsh_history,target=/root/.zsh_history,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly",
    "source=aws-sso-cache,target=/root/.aws/sso,type=volume",
    "source=twilio-config,target=/root/.twilio-cli,type=volume"
  ],
  "forwardPorts": [
    3000,
    3100,
    3200,
    6379,
    4040
  ],
  "portsAttributes": {
    "3000": {
      "label": "Grafana",
      "onAutoForward": "notify"
    },
    "3100": {
      "label": "Loki",
      "onAutoForward": "notify"
    },
    "3200": {
      "label": "Tempo",
      "onAutoForward": "notify"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "notify"
    },
    "4040": {
      "label": "Ngrok",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {
        "chat.mcp.enabled": true,
        "editor.tabSize": 4,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "zsh"
          }
        }
      },
      "mcp": {
        // postman
      }
    }
  },
  "containerEnv": {
    "HISTFILE": "/root/.zsh_history",
    "HISTSIZE": "100000",
    "SAVEHIST": "100000"
  },
  "postCreateCommand": "cd ${containerWorkspaceFolder}/dotfiles && ./install.sh",
  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/scripts/mark-git-safe.sh && git config --global url.\"https://${GITHUB_TOKEN}@github.com/\".insteadOf \"https://github.com/\" && grep -qF 'source ${containerWorkspaceFolder}/.devcontainer/aliases.sh' ~/.zshrc || echo 'source ${containerWorkspaceFolder}/.devcontainer/aliases.sh' >> ~/.zshrc"
}