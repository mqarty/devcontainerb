{
  "name": "⚡ ⚡ devcontainerb ⚡ ⚡",
  "privileged": true,
  "overrideCommand": false,
  "build": {
    "dockerfile": "./Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "daemonArgs": "--iptables=false --ip6tables=false" // ✅ fixes iptables on Apple
    }
  },
  // Load environment variables from .env file (create from .env.example)
  "runArgs": [
    "--name",
    "devcontainer-workspace",
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/.env",
    // "--gpus",
    // "all",
    "--cgroupns=host"
  ],
  // "initializeCommand": "bash -lc 'bash ${localWorkspaceFolder}/.devcontainer/scripts/ghcr-login.sh ${localWorkspaceFolder}'",
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/CLAUDE.md,target=${containerWorkspaceFolder}/.github/CLAUDE.md,type=bind",
    "source=${localWorkspaceFolder}/dotfiles,target=/root/dotfiles,type=bind",
    "source=zsh-history,target=/root/.zsh_history_container,type=volume",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind",
    "source=gh-config,target=/root/.config/gh,type=volume",
    "source=aws-sso-cache,target=/root/.aws/sso,type=volume",
    "source=twilio-config,target=/root/.twilio-cli,type=volume"
  ],
  "containerEnv": {
    "HISTFILE": "/root/.zsh_history_container/.zsh_history",
    "HISTSIZE": "100000",
    "SAVEHIST": "100000",
    "AWS_PROFILE": "dev",
    // The GODEBUG=netdns=cgo forces Go to use the same C DNS resolver that curl/nslookup use, avoiding the UDP timeout issue.
    // For Terraform
    "GODEBUG": "netdns=cgo"
  },
  "postCreateCommand": "bash -lc '${containerWorkspaceFolder}/.devcontainer/scripts/post-create.sh'",
  "postStartCommand": "bash -lc '${containerWorkspaceFolder}/.devcontainer/scripts/post-start.sh'",
  "forwardPorts": [
    3000,
    3001,
    6379,
    4040,
    4566,
    8001,
    8080,
    8888,
    9090,
    16686
  ],
  "portsAttributes": {
    "3001": {
      "label": "Twilio Dev Phone",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Pulse",
      "onAutoForward": "notify"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "notify"
    },
    "4040": {
      "label": "Ngrok",
      "onAutoForward": "notify"
    },
    "4566": {
      "label": "LocalStack",
      "onAutoForward": "notify"
    },
    "8001": {
      "label": "DynamoDB Admin UI",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "cohorts-api",
      "onAutoForward": "notify"
    },
    "8888": {
      "label": "Jupyter Notebook",
      "onAutoForward": "notify"
    },
    "9090": {
      "label": "Prometheus",
      "onAutoForward": "notify"
    },
    "16686": {
      "label": "Jaeger",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "chat.mcp.enabled": true,
        "editor.tabSize": 4,
        "extensions.ignoreRecommendations": true,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        },
        "[hcl]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        }
      },
      "mcp": {
        "servers": {
          "terraform": {
            "command": "docker",
            "args": [
              "run",
              "-i",
              "--rm",
              "hashicorp/terraform-mcp-server"
            ]
          },
          "postman": {
            "type": "http",
            "url": "https://mcp.postman.com/mcp",
            "headers": {
              "Authorization": "${input:Authorization}"
            },
            "gallery": "https://api.mcp.github.com",
            "version": "2.8.7"
          },
          "figma": {
            "type": "http",
            "url": "https://mcp.figma.com/mcp",
            "gallery": "https://api.mcp.github.com",
            "version": "1.0.3"
          }
        }
      }
    }
  }
}
