{
  "name": "⚡ ⚡ devcontainerb ⚡ ⚡",
  "build": {
    "dockerfile": "./Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.zsh_history,target=/root/.zsh_history,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly",
    "source=aws-sso-cache,target=/root/.aws/sso,type=volume",
    "source=twilio-config,target=/root/.twilio-cli,type=volume",
    "source=${localWorkspaceFolder},target=/workspaces/Code,type=bind"
  ],
  "runArgs": [
    "--name",
    "devcontainer-workspace"
  ],
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {
        "chat.mcp.enabled": true,
        "editor.tabSize": 4,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "zsh"
          }
        }
      },
      "mcp": {
        // postman
      }
    }
  },
  "containerEnv": {
    "HISTFILE": "/root/.zsh_history",
    "HISTSIZE": "100000",
    "SAVEHIST": "100000",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "TWILIO_ACCOUNT_SID": "${localEnv:TWILIO_ACCOUNT_SID}",
    "TWILIO_AUTH_TOKEN": "${localEnv:TWILIO_AUTH_TOKEN}",
    "TZ": "${localEnv:TZ}"
  },
  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/scripts/mark-git-safe.sh && zsh -c 'omz update' || true"
}