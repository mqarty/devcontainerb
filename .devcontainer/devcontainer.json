{
  "name": "⚡ ⚡ devcontainerb ⚡ ⚡",
  "build": {
    "dockerfile": "./Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // Load environment variables from .env file (create from .env.example)
  "runArgs": [
    "--name",
    "devcontainer-workspace",
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/.env"
  ],
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/CLAUDE.md,target=${containerWorkspaceFolder}/.github/CLAUDE.md,type=bind",
    "source=zsh-history,target=/root/.zsh_history_container,type=volume",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind",
    "source=${localWorkspaceFolder}/dotfiles,target=/root/dotfiles,type=bind",
    "source=gh-config,target=/root/.config/gh,type=volume",
    "source=aws-sso-cache,target=/root/.aws/sso,type=volume",
    "source=twilio-config,target=/root/.twilio-cli,type=volume"
  ],
  "forwardPorts": [
    3000,
    3001,
    6379,
    4040,
    4566,
    8001,
    8080,
    8888,
    9090,
    16686
  ],
  "portsAttributes": {
    "3001": {
      "label": "Twilio Dev Phone",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Pulse",
      "onAutoForward": "notify"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "notify"
    },
    "4040": {
      "label": "Ngrok",
      "onAutoForward": "notify"
    },
    "4566": {
      "label": "LocalStack",
      "onAutoForward": "notify"
    },
    "8001": {
      "label": "DynamoDB Admin UI",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "cohorts-api",
      "onAutoForward": "notify"
    },
    "8888": {
      "label": "Jupyter Notebook",
      "onAutoForward": "notify"
    },
    "9090": {
      "label": "Prometheus",
      "onAutoForward": "notify"
    },
    "16686": {
      "label": "Jaeger",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "MermaidChart.vscode-mermaid-chart",
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "AmazonWebServices.aws-toolkit-vscode",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "chat.mcp.enabled": true,
        "editor.tabSize": 4,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "zsh"
          }
        },
        "extensions.ignoreRecommendations": true,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        },
        "[hcl]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        }
      },
      "mcp": {
        "servers": {
          "terraform": {
            "command": "docker",
            "args": [
              "run",
              "-i",
              "--rm",
              "hashicorp/terraform-mcp-server"
            ]
          }
        }
      }
    }
  },
  "containerEnv": {
    "HISTFILE": "/root/.zsh_history_container/.zsh_history",
    "HISTSIZE": "100000",
    "SAVEHIST": "100000",
    "AWS_PROFILE": "dev",
    // The GODEBUG=netdns=cgo forces Go to use the same C DNS resolver that curl/nslookup use, avoiding the UDP timeout issue.
    // For Terraform
    "GODEBUG": "netdns=cgo"
  },
  "postCreateCommand": "bash -lc 'cd /root/dotfiles && bash install.sh && if command -v gh >/dev/null 2>&1 && [ -n \"${GITHUB_TOKEN:-}\" ]; then printf \"%s\" \"${GITHUB_TOKEN}\" | gh auth login --hostname github.com --with-token >/dev/null 2>&1 || true; gh auth setup-git >/dev/null 2>&1 || true; fi && bash ${containerWorkspaceFolder}/.devcontainer/scripts/poetry-init.sh voice-core'",
  "postStartCommand": "bash -lc 'bash ${containerWorkspaceFolder}/.devcontainer/scripts/mark-git-safe.sh && if command -v gh >/dev/null 2>&1 && [ -n \"${GITHUB_TOKEN:-}\" ]; then printf \"%s\" \"${GITHUB_TOKEN}\" | gh auth login --hostname github.com --with-token >/dev/null 2>&1 || true; gh auth setup-git >/dev/null 2>&1 || true; fi && if ! grep -qF \"source ${containerWorkspaceFolder}/.devcontainer/aliases.sh\" ~/.zshrc; then echo \"source ${containerWorkspaceFolder}/.devcontainer/aliases.sh\" >> ~/.zshrc; fi'"
}
