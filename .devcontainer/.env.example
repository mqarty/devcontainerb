# Copy this file to .env and fill in your values.
# .env is gitignored and loaded by the devcontainer at startup.
#
# This is the canonical shared setup for project secrets.
# Dotfiles (for example ~/.zshrc.secrets) are optional and user-specific.
#
# Quick setup: run setup-env.sh to auto-populate from your current shell.
# Manual setup: cp .env.example .env && code .env

# GitHub Personal Access Token (for private repos and API access)
# Get it from: https://github.com/settings/tokens
# Required for docker compose build secrets that clone private GitHub repos.
GITHUB_TOKEN=ghp_your_token_here

# Twilio credentials
# Get them from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Optional: Twilio Dev Phone number (if you want to always use a specific number)
# Format: +1XXXXXXXXXX (E.164 format with country code)
TWILIO_DEV_PHONE_NUMBER=1555KL56893

# Optional: Default TO number for Dev Phone UI (configure in UI, this is just a reference)
# Format: +1XXXXXXXXXX (E.164 format with country code)
TWILIO_PHONE_TO_NUMBER=+19254306829

# Optional: Force overwrite of existing webhook configuration
# TWILIO_DEV_PHONE_FORCE=true

# ngrok auth token
# Get it from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=your_ngrok_token_here

# Timezone (optional - defaults to UTC in container)
TZ=America/New_York

# History settings (optional - already configured in devcontainer.json)
# HISTFILE=/root/.zsh_history
# HISTSIZE=100000
# SAVEHIST=100000

# Optional: Enable/disable color output in terminal
# 0 = no color, 1 = auto-detect and enable color
FORCE_COLOR=1
