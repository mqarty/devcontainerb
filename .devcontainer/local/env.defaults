# Shared, non-secret devcontainer config. COMMITTED (unlike .env, which is generated).
# build-env.sh merges: env.defaults + decrypted secrets + env.local (personal, gitignored).
# Put credentials in secrets.json (SOPS-encrypted); put personal/identifying values
# (your phone numbers, ngrok domain) in env.local — see env.local.example. Never here.

# Twilio Dev Phone (shared flag; account SID/auth token are secrets, numbers are personal)
TWILIO_DEV_PHONE_FORCE=true

# Timezone
TZ=America/Los_Angeles

# History settings — persisted in a named volume across rebuilds
HISTFILE=/root/.shell_history_dir/.zsh_history
HISTSIZE=100000
SAVEHIST=100000

# Locale
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8

# Terminal color: 0 = off, 1 = auto-detect
FORCE_COLOR=1
