# Personal, per-developer overrides. COPY to env.local (gitignored) and edit.
# build-env.sh appends env.local LAST, so anything here overrides env.defaults
# and the decrypted secrets. Use it for identifying values you don't want in git,
# or to point the devcontainer at your own resources.

# Your Twilio Dev Phone number (E.164)
TWILIO_DEV_PHONE_NUMBER=+1XXXXXXXXXX
# Default "to" number for the Dev Phone UI (E.164)
TWILIO_PHONE_TO_NUMBER=+1XXXXXXXXXX

# Your reserved ngrok static domain
NGROK_STATIC_DOMAIN=your-subdomain.ngrok-free.app
