# Copy this file to `env.local` (gitignored) and fill in real values.
#
# env.local holds ALL secrets for the devcontainer. There is no encryption and
# nothing here is committed — the shared team secrets are copied once from the
# team password manager (1Password), the personal ones are your own tokens.
# build-env.sh merges env.defaults + env.local -> .env; env.local wins on
# duplicate keys. Put non-secret shared config in env.defaults, not here.

# ============================================================================
# SHARED — same values for the whole team. Get these from 1Password (Dev vault).
# ============================================================================

# Twilio — https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Roark API key
ROARK_API_KEY=roark_your_api_key

# ============================================================================
# PERSONAL — your own per-developer tokens. Do not share these.
# ============================================================================

# GitHub PAT — private repos + docker build secrets. https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# npm registry token (private packages)
NPM_TOKEN=npm_your_token_here

# ngrok auth token — https://dashboard.ngrok.com/get-started/your-authtoken
# NOTE: var name is NGROK_AUTHTOKEN (no underscore), matching the ngrok agent.
NGROK_AUTHTOKEN=your_ngrok_authtoken

# Jira API token — https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token

# PostHog personal API key — used by the PostHog MCP server (see devcontainer.json).
# https://us.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=phx_your_posthog_personal_api_key

# ============================================================================
# PERSONAL — identifying / resource overrides (non-secret, but per-developer)
# ============================================================================

# Your Twilio Dev Phone number (E.164)
TWILIO_DEV_PHONE_NUMBER=+1XXXXXXXXXX
# Default "to" number for the Dev Phone UI (E.164)
TWILIO_PHONE_TO_NUMBER=+1XXXXXXXXXX
# Your reserved ngrok static domain
NGROK_STATIC_DOMAIN=your-subdomain.ngrok-free.app
