# Reference only — the real .env is GENERATED, not copied from this file.
# .env is gitignored and assembled by scripts/build-env.sh from three sources:
#   - secrets.json.example  -> the credentials below (SOPS-encrypted in secrets.enc.json)
#   - env.defaults          -> shared non-secret config (TZ, locale, history, color)
#   - env.local             -> personal per-dev overrides (phone numbers, ngrok domain);
#                              gitignored, copy from env.local.example. Applied last / wins.
#
# CANONICAL SETUP (SOPS), from .devcontainer/ inside the container (`make help`):
#   1. make secrets          # cp secrets.json.example -> secrets.json; fill in values
#   2. make encrypt-secrets  # -> secrets.enc.json (commit this)
#   3. make build-env        # decrypts + merges env.defaults -> .env
# On rebuild, post-create.sh runs build-env.sh automatically. Do not hand-edit .env.

# --- Credentials (managed in secrets.json / secrets.enc.json) ---

# GitHub PAT — private repos + docker build secrets. https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# npm registry token (private packages)
NPM_TOKEN=npm_your_token_here

# Twilio — https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# ngrok auth token — https://dashboard.ngrok.com/get-started/your-authtoken
# NOTE: var name is NGROK_AUTHTOKEN (no underscore), matching the ngrok agent.
NGROK_AUTHTOKEN=your_ngrok_authtoken

# Jira API token — https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token

# Roark API key
ROARK_API_KEY=roark_your_api_key

# PostHog personal API key — used by the PostHog MCP server (see devcontainer.json).
# Get it from: https://us.posthog.com/settings/user-api-keys
# (POSTHOG_PROJECT_ID / POSTHOG_HOST are non-secret and set in devcontainer.json.)
POSTHOG_PERSONAL_API_KEY=phx_your_posthog_personal_api_key

# --- Non-secret config lives in env.defaults (committed), not here. ---
