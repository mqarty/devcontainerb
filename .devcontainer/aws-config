[sso-session rg]
sso_start_url = https://radiantgraph.awsapps.com/start/
sso_region = us-east-1
sso_registration_scopes = sso:account:access

[profile dev]
sso_session = rg
duration_seconds = 7200

[default]
region = us-east-1
output = json

[profile localstack]
region = us-east-1
endpoint_url = http://localhost:4566
