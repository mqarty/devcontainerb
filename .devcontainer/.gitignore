# These patterns have no leading slash, so they match recursively — they cover
# the files in local/ too (local/.env, local/env.local).

# Generated env-file (built by scripts/build-env.sh) — never commit.
.env

# All secrets (shared team + personal) — never commit (env.local.example is the template).
env.local

# Backups / editor stray copies — may contain real secrets, never commit.
*.bak
*~
*.swp
